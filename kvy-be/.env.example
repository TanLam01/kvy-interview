# Database Configuration
DATABASE_URL="postgresql://root:secret@localhost:5432/postgres?schema=public"

# Redis Configuration (BullMQ)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Application Configuration
PORT=3000
JWT_SECRET="your-super-secret-jwt-key"
CORS_ORIGINS="http://localhost:5173"
SHOW_SEED_CREDENTIALS="false"

# Verification Service Configuration
MOCK_VERIFIER_URL="http://localhost:3000/api/mock-verifier"
WEBHOOK_URL="http://localhost:3000/api/verifier-webhook"
WEBHOOK_SECRET="your-verifier-webhook-secret"

# Reconciliation
RECONCILIATION_INTERVAL_MS=60000
RECONCILIATION_STALE_MS=300000
